    <string name="roadmap_intro">התכונות האלה דורשות שרת, חשבונות משתמשים או פיקוח, ולכן עוד לא פעילות. אין כאן כפתורים: כל תכונה תושק כשתעבוד כראוי ובבטחה.</string>
    <string name="rm_accounts">חשבונות ופרופילים</string>
    <string name="rm_accounts_why">כניסה מאובטחת, פרופיל ציבורי ומועדפים מסונכרנים. דורש הפעלת הרשמה בשרת עם כללים שמונעים ממשתמש לגעת בנתוני אחר.</string>
    <string name="rm_uploads">העלאות קהילה עם פיקוח</string>
    <string name="rm_uploads_why">העלו רקעים משלכם. כל העלאה תיבדק לפני פרסום, עם דיווח וחסימה כפי ש-Google Play דורשת לתוכן משתמשים.</string>
    <string name="rm_social">לייקים, מעקב ודפי יוצרים</string>
    <string name="rm_social_why">עקבו אחרי יוצרים וסמנו לייק. תלוי בחשבונות ובהעלאות.</string>
    <string name="rm_ai">יצירת רקעים בבינה מלאכותית מתיאור</string>
    <string name="rm_ai_why">כתבו רעיון וקבלו רקע. דורש מודל תמונות בענן, מכסת שימוש וסינון תוכן. לשונית היצירה כבר מעצבת עבורכם בטלפון.</string>
    <string name="rm_icons">חבילות אייקונים תואמות</string>
    <string name="rm_icons_why">אייקונים בגוון שמתאים לרקע. דורש שילוב עם המשגר שמשתנה בין יצרנים.</string>
    <string name="rm_subs">תוכניות מנוי</string>
    <string name="rm_subs_why">אפשרויות חודשיות ושנתיות. Wallora Pro הוא כיום רכישה חד-פעמית.</string>
    <string name="rm_global">דירוג ההורדות העולמי</string>
    <string name="rm_global_why">דורש מונה הורדות משותף בשרת. הרשימה האישית שלכם פועלת כבר עכשיו.</string>
    <string name="rm_admin">מנהל: משתמשים וניתוח נתונים</string>
    <string name="rm_admin_why">דף הניהול מנהל כיום רקעים וקטגוריות. ניהול משתמשים וניתוחים דורשים חשבונות; הניתוחים זמינים בקונסולת Firebase.</string>
