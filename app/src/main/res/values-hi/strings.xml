    <string name="coming_soon">जल्द आ रहा है</string>
    <string name="roadmap_intro">इन सुविधाओं के लिए सर्वर, यूज़र खाते या मॉडरेशन चाहिए, इसलिए ये अभी चालू नहीं हैं। यहाँ कुछ भी बटन नहीं है: हर सुविधा तब आएगी जब वह ठीक से और सुरक्षित रूप से काम कर सके।</string>
    <string name="rm_accounts">खाते और प्रोफ़ाइल</string>
    <string name="rm_accounts_why">सुरक्षित साइन-इन, सार्वजनिक प्रोफ़ाइल और क्लाउड से सिंक होने वाले पसंदीदा। इसके लिए सर्वर पर खाता साइन-अप चालू करना होगा, ऐसे नियमों के साथ जो एक यूज़र को दूसरे के डेटा को छूने से रोकें।</string>
    <string name="rm_uploads">मॉडरेशन के साथ कम्युनिटी अपलोड</string>
    <string name="rm_uploads_why">अपने वॉलपेपर अपलोड करें। हर अपलोड सार्वजनिक होने से पहले जाँचा जाएगा, रिपोर्ट और ब्लॉक के साथ, जैसा Google Play यूज़र-जनित सामग्री के लिए माँगता है।</string>
    <string name="rm_social">लाइक, फ़ॉलो और क्रिएटर पेज</string>
    <string name="rm_social_why">क्रिएटरों को फ़ॉलो करें और वॉलपेपर लाइक करें। यह खातों और अपलोड पर निर्भर है।</string>
    <string name="rm_ai">प्रॉम्प्ट से AI वॉलपेपर बनाना</string>
    <string name="rm_ai_why">एक आइडिया लिखें, वॉलपेपर पाएँ। इसके लिए क्लाउड इमेज मॉडल, उपयोग की सीमा और कंटेंट फ़िल्टर चाहिए।</string>
    <string name="rm_icons">मेल खाते आइकन पैक</string>
    <string name="rm_icons_why">वॉलपेपर से मेल खाते रंगों वाले आइकन सेट। इसके लिए लॉन्चर इंटीग्रेशन चाहिए, जो फ़ोन बनाने वाली कंपनी के अनुसार अलग होता है।</string>
    <string name="rm_subs">सब्सक्रिप्शन प्लान</string>
