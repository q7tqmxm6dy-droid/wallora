    <string name="roadmap_title">What\'s coming</string>
    <string name="coming_soon">Coming soon</string>
    <string name="roadmap_intro">These features need a server, user accounts or moderation, so they are not switched on yet. Nothing here is a button: each one ships when it can work properly and safely.</string>
    <string name="rm_accounts">Accounts and profiles</string>
    <string name="rm_accounts_why">Secure sign-in, a public profile and cloud-synced favourites. Needs account sign-up turned on in the backend, with rules that stop one user touching another\'s data.</string>
    <string name="rm_uploads">Community uploads with moderation</string>
    <string name="rm_uploads_why">Upload your own wallpapers. Every upload would be reviewed before it is public, with reporting and blocking, as Google Play requires for user-generated content.</string>
    <string name="rm_social">Likes, following and creator pages</string>
    <string name="rm_social_why">Follow creators and like wallpapers. Depends on accounts and uploads.</string>
    <string name="rm_ai">AI wallpaper generation from a prompt</string>
    <string name="rm_ai_why">Type an idea, get a wallpaper. Needs a cloud image model, a usage quota and content filtering. The Create tab already makes designs on your phone.</string>
    <string name="rm_icons">Matching icon packs</string>
    <string name="rm_icons_why">Icon sets tinted to match a wallpaper. Needs launcher integration that varies by phone maker.</string>
    <string name="rm_subs">Subscription plans</string>
    <string name="rm_subs_why">Monthly and yearly options. Wallora Pro is a one-time purchase today.</string>
    <string name="rm_global">Worldwide most-downloaded ranking</string>
    <string name="rm_global_why">Needs a shared download counter on the server. Your own most-downloaded list works now.</string>
    <string name="rm_admin">Admin: users and analytics</string>
    <string name="rm_admin_why">The admin page manages wallpapers and categories today. User management and analytics need accounts; analytics are in the Firebase console meanwhile.</string>
