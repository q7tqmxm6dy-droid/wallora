# Copy to keystore.properties and fill in. keystore.properties is git-ignored.
#
# Generate the key once with:
#   keytool -genkeypair -v -keystore keys/wallora-upload.jks \
#     -alias wallora -keyalg RSA -keysize 4096 -validity 10000
#
# Keep a backup of wallora-upload.jks AND this password somewhere safe.
# If you lose them you cannot publish an update to the existing listing.

storeFile=keys/wallora-upload.jks
storePassword=CHANGE_ME
keyAlias=wallora
keyPassword=CHANGE_ME
