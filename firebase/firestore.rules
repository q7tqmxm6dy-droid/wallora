rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everyone (including the app) can read the catalogue.
    match /wallpapers/{wallpaperId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // A signed-in member's own backup (favourite ids and album contents). Nobody else can read or write it,
    // and the document is capped so it cannot be abused as free storage.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['favorites', 'collections', 'updatedAt'])
        && request.resource.data.favorites is list && request.resource.data.favorites.size() <= 2000
        && request.resource.data.collections is string && request.resource.data.collections.size() <= 100000;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }

  // Only the owner's account may change content.
  //
  // This used to be `request.auth != null`, which combined with public sign-up meant anyone
  // could create an account and then delete or deface the entire catalogue. Sign-ups are now
  // disabled; this check is the second line of defence, so an account created by any other
  // route still cannot touch the content.
  function isAdmin() {
    return request.auth != null
      && request.auth.uid == 'W63zSk1QAmXe0QJusXrrpSVHYNC2';
  }
}
